# ProTrack 后端环境配置示例
# 复制此文件为 .env 并按需修改
# ⚠️  .env 文件不应提交到版本库（已加入 .gitignore）

# ── 必填 ──────────────────────────────────────────────────────────────────────
# JWT 签名密钥，生产环境请使用随机长字符串（建议 64 字符以上）
# 生成方式：python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=your-random-secret-key-here

# ── 可选 ──────────────────────────────────────────────────────────────────────
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# 是否写入示例种子数据（true / false），生产环境建议 false
SEED_DATA=true

# 默认管理员账号（仅 SEED_DATA=true 且库中无用户时生效）
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123

# CORS 允许来源，逗号分隔；* 表示不限制
ALLOWED_ORIGINS=*
